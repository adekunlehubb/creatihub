# ============================================================
# CreatiHub environment configuration
# Copy this file to ".env" and fill in your values, then start
# the server with:  node server.js  (env vars are read from the
# process environment — load them with `export`, a process
# manager like PM2, or your host's env-var settings)
# ============================================================

# ---------------- Paystack ----------------
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys (sk_test_/pk_test_) while developing, LIVE keys in production.

# Secret key — REQUIRED for real payments. Never expose it to the frontend.
# When this is empty, CreatiHub runs in TEST/DEMO mode and simulates payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public key — used by the browser to open the Paystack inline popup.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the URL Paystack redirects to after payment.
# Defaults to https://your-domain/payment/callback
# PAYSTACK_CALLBACK_URL=https://your-domain.com/payment/callback

# ---------------- Server ----------------
# PORT=3000

# ---------------- Email (Resend) ----------------
# CreatiHub sends transactional emails to customers when their deliverables
# are ready, when revisions are completed, and for password resets.
#
# Set RESEND_API_KEY to enable real email delivery. Without it, emails are
# logged in the admin panel (status "logged_only") but not actually sent.
#
# Get a free key at: https://resend.com/api-keys (3,000 emails/month free)
#
# RESEND_FROM_EMAIL must use a domain you've verified in Resend. For testing
# only, you can use Resend's default address (onboarding@resend.dev) which
# can only send to YOUR OWN account email — verify your domain for real
# customers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CreatiHub <onboarding@resend.dev>

# ---------------- Database (PRODUCTION) ----------------
# Set DATABASE_URL to a PostgreSQL connection string for BULLETPROOF
# persistence. Your users' accounts, orders, and subscriptions will survive
# redeploys, restarts, and crashes. Without this, CreatiHub uses a local
# JSON file (data/db.json) which can be lost on ephemeral hosting.
#
# Get a free Postgres from: Render, Railway, Supabase, or Neon.
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# Set PGSSL=false ONLY for local Postgres without SSL. Leave unset for
# production (hosted Postgres requires SSL).
# PGSSL=false

# ---------------- AI Generation Engine ----------------
# CreatiHub automatically generates real creative deliverables for every
# order the moment payment is confirmed (images, voiceovers, copywriting,
# translations, video assets, website templates, chatbot widgets, etc.).
#
# The engine supports TWO AI providers and auto-detects which keys are set:
#
#   1. GEMINI  (Google)  — FREE tier, no credit card needed.
#      Get your key at: https://aistudio.google.com/app/apikey
#      With ONLY a Gemini key, ALL 19 services work:
#        - gemini-3.5-flash           → text (SEO copy, email, pitch decks)
#        - gemini-3.5-flash           → translation
#        - gemini-3.1-flash-image     → images (NOTE: free tier has 0 image
#                                       quota → falls back to a detailed
#                                       visual concept brief with a
#                                       ready-to-use AI prompt)
#        - gemini-3.1-flash-tts-preview → audio / TTS (voiceovers, jingles)
#                                       → outputs playable .wav files
#        - poster + script            → video assets
#        - template-based             → website / chatbot HTML
#
#   2. OPENAI  (paid)    — requires billing / credits.
#      Get your key at: https://platform.openai.com/api-keys
#      With an OpenAI key, images upgrade to real DALL-E 3 output and
#      text uses GPT-4o. If BOTH keys are set, OpenAI is preferred for
#      images and text (higher quality), Gemini is the fallback.
#
# Set AT LEAST ONE of the two keys below. If neither is set, the engine
# refuses to generate and the order timeline records a clear error.
GEMINI_API_KEY=

# Optional: override Gemini models (defaults shown — current as of 2026).
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional: Gemini TTS voice (Kore | Puck | Zephyr | Aoede | Charon | Fenrir | Leda | Orus)
# GEMINI_TTS_VOICE=Kore

OPENAI_API_KEY=

# Optional: override the OpenAI base URL (useful for Azure OpenAI proxies
# or OpenAI-compatible endpoints like Together / Groq / OpenRouter).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the models used (defaults shown).
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_TTS_VOICE=alloy   # alloy | echo | fable | onyx | nova | shimmer

# Auto-generation: the engine generates deliverables automatically when
# payment is confirmed. Set to "false" to disable auto-generation (orders
# will be marked paid but the admin must click "Generate" manually).
# AUTO_GENERATE=true
